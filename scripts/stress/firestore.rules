// Emulator-only copy of the rules in docs/SECURITY_AND_DEPLOYMENT.md (section 1),
// so stress runs also exercise them. This file is NOT what production uses.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /games/{gameId} {
      allow read: if true;
      allow write: if isAuthenticated();

      match /teams/{teamId} {
        allow read: if true;
        allow create, update: if isAuthenticated();
        allow delete: if false;
      }

      match /clues/{clueId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      match /submissions/{submissionId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.selfieBase64.size() < 300000;
        allow update, delete: if isAuthenticated();
      }
    }
  }
}
